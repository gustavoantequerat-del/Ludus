# Copia este archivo a .env (o configura la variable en el panel del hosting).

# Direccion de la API. En desarrollo no hace falta: Vite hace proxy de /api y
# /archivos hacia http://localhost:3000.
# En produccion, si el backend esta en otro dominio, ponlo completo:
#   VITE_URL_API=https://api.tu-dominio.com/api
VITE_URL_API=
