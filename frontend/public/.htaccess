# Enrutado del SPA en Apache (cPanel): cualquier ruta que no sea un archivo
# real la resuelve index.html, porque las rutas de Vue viven en el navegador.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
