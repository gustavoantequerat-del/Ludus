# Copia este archivo a .env y ajusta los valores para tu entorno local.

# Servidor
PUERTO=3000

# PostgreSQL (debe existir previamente; este proyecto no crea la base de datos)
DB_HOST=localhost
DB_PUERTO=5432
DB_USUARIO=sistema_juegos
DB_CLAVE=sistema_juegos
DB_NOMBRE=sistema_juegos

# JWT
JWT_SECRETO=cambia-este-valor-en-produccion
JWT_EXPIRACION=8h

# Carpeta con las imagenes del juego (personajes y fondos). Se sirve en
# /archivos. Por defecto es backend/archivos; conviene apuntarla a un volumen
# persistente en produccion, porque ahi se guarda lo que sube el docente.
RUTA_ARCHIVOS=

# URL publica de esta API. Se escribe dentro de cada paquete SCORM, asi que
# tiene que ser alcanzable desde el LMS donde se suba el paquete (no localhost
# si el LMS corre en otra maquina).
URL_PUBLICA_API=http://localhost:3000/api
