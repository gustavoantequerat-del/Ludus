# Copia este archivo a .env y ajusta los valores para tu entorno local.

# Servidor
PUERTO=3000

# PostgreSQL (debe existir previamente; este proyecto no crea la base de datos)
DB_HOST=localhost
DB_PUERTO=5432
DB_USUARIO=sistema_juegos
DB_CLAVE=sistema_juegos
DB_NOMBRE=sistema_juegos

# JWT
JWT_SECRETO=cambia-este-valor-en-produccion
JWT_EXPIRACION=8h
