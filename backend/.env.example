# Copia este archivo a .env y ajusta los valores para tu entorno local.
# En un hosting, estas mismas variables se pueden cargar en el .env del
# servidor (cPanel no tiene panel de variables para PHP: va en el archivo).

# Puerto de "php artisan serve" en desarrollo. El frontend (Vite) espera la
# API en el 3000. En cPanel no se usa: la API la sirve Apache.
PUERTO=3000

# --- PostgreSQL ---
# Hay dos formas de configurar la base, y podes tener las dos cargadas a la
# vez (por ejemplo un Postgres local para trabajar rapido, y la URL de Neon a
# mano para probar contra la base real).

# 1) Variables sueltas (local, cPanel con base propia):
DB_HOST=localhost
DB_PUERTO=5432
DB_USUARIO=sistema_juegos
DB_CLAVE=sistema_juegos
DB_NOMBRE=sistema_juegos

# 2) O la cadena completa, que es lo que entregan Neon, Render o Railway.
#   DATABASE_URL=postgresql://usuario:clave@host/base?sslmode=require
DATABASE_URL=

# Cual de las dos usar. Vacio = si hay DATABASE_URL la usa, si no cae a las
# variables sueltas (asi funcionan los despliegues que solo configuran una).
# Con las dos cargadas, este valor manda y la otra se ignora del todo:
#   DB_ORIGEN=local   -> usa DB_HOST/DB_PUERTO/... e ignora DATABASE_URL
#   DB_ORIGEN=neon    -> usa DATABASE_URL e ignora las variables sueltas
DB_ORIGEN=

# TLS contra la base. Casi todos los Postgres gestionados lo exigen.
# Si la DATABASE_URL trae sslmode=require no hace falta tocarlo; con las
# variables sueltas hay que poner DB_SSL=true a mano cuando la base es remota.
DB_SSL=

# JWT
JWT_SECRETO=cambia-este-valor-en-produccion
JWT_EXPIRACION=8h

# Carpeta con las imagenes del juego (personajes y fondos). Se sirve en
# /archivos. Por defecto es public/archivos, que Apache entrega directo;
# dejalo vacio salvo que quieras guardar las imagenes en otro lado.
RUTA_ARCHIVOS=

# URL publica de esta API. Se escribe dentro de cada paquete SCORM, asi que
# tiene que ser alcanzable desde el LMS donde se suba el paquete (no localhost
# si el LMS corre en otra maquina). Con https:// y terminada en /api.
URL_PUBLICA_API=http://localhost:3000/api

# En true los errores 500 muestran el detalle. Solo para depurar, nunca en
# produccion.
APP_DEBUG=false
