{
  "name": "sistema-juegos-backend",
  "version": "1.0.0",
  "description": "Backend NestJS del Sistema de Juegos Educativos (Ludus)",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "migracion:generar": "typeorm-ts-node-commonjs migration:generate -d src/configuracion/datos-origen.ts",
    "migracion:ejecutar": "typeorm-ts-node-commonjs migration:run -d src/configuracion/datos-origen.ts",
    "migracion:revertir": "typeorm-ts-node-commonjs migration:revert -d src/configuracion/datos-origen.ts",
    "semilla": "ts-node -r tsconfig-paths/register src/semilla/semilla.ts",
    "bd:verificar": "ts-node -r tsconfig-paths/register src/herramientas/verificar-bd.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.6",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.6",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/mapped-types": "^2.0.6",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.6",
    "@nestjs/typeorm": "^10.0.2",
    "bcrypt": "^5.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.4.5",
    "jszip": "^3.10.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.7",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^5.0.0",
    "@types/node": "^22.9.0",
    "@types/passport-jwt": "^4.0.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.6.3"
  }
}
