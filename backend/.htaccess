# Por si el dominio apunta a esta carpeta y no a public/: todo se sirve desde
# public/, asi el .env, vendor/ y el resto del proyecto nunca quedan expuestos.
# /.well-known queda afuera para que el SSL automatico de cPanel (AutoSSL)
# pueda validar el dominio.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_URI} !^/\.well-known/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

<FilesMatch "^\.">
    Require all denied
</FilesMatch>
